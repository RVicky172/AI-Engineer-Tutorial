# Copy to .env (same folder) and fill in. Never commit .env.

# PostgreSQL + pgvector from docker-compose.yml (local only)
PG_DSN=postgresql://rag:rag@localhost:5432/rag

# Answer generation (Lab 01 ask/answer-golden, Lab 04 judge): same variables as M02.
LLM_PROVIDER=anthropic          # or bedrock
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=              # or `ant auth login`

# Bedrock: Titan embeddings (--embedder titan) and Lab 02 Knowledge Bases
AWS_PROFILE=sandbox
AWS_REGION=us-east-1

# After the first download of the local embedding model, skip the online version check:
# HF_HUB_OFFLINE=1
