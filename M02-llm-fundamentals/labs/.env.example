# Copy to .env (same folder) and fill in. Never commit .env. Variables exported in your shell
# win over this file. Credentials are NOT read from here by the labs: the SDKs find them.

# Which API the labs call: anthropic (Claude API, default) or bedrock (Claude on Amazon Bedrock)
LLM_PROVIDER=anthropic

# Model for every lab. Default claude-opus-5-5. claude-haiku-5-5 is ~40x cheaper for iterating;
# compare both on Lab 01 before you decide which one the task needs.
LLM_MODEL=claude-opus-5-5

# --- Claude API (LLM_PROVIDER=anthropic) ---
# Either `ant auth login` once, or put a key here (the SDK reads ANTHROPIC_API_KEY itself).
ANTHROPIC_API_KEY=

# --- Bedrock (LLM_PROVIDER=bedrock) ---
# Uses the AWS credential chain. Enable model access in the Bedrock console first.
AWS_PROFILE=sandbox
AWS_REGION=us-east-1
